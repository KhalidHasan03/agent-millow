APP_NAME="Agent Millow"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=json
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=agent_millow_dev
DB_USERNAME=agent_millow
DB_PASSWORD=
DB_TIMEZONE=+00:00

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SESSION_COOKIE=agent_millow_session
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:8000,127.0.0.1:5173,127.0.0.1:8000
SANCTUM_TOKEN_PREFIX=agent_millow_
CORS_ALLOWED_ORIGINS=http://localhost:5173

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=agent_millow

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@agentmillow.local"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Production: set APP_DEBUG=false, APP_ENV=production, SESSION_SECURE_COOKIE=true,
# configure HTTPS, and replace the local CORS origin with the deployed frontend.

# LLM providers. The deterministic fake provider is the default locally and in
# tests and performs no network calls. Real provider keys stay server-side and
# are never exposed to the client. Only enable a provider you intend to use.
AGENT_MILLOW_DEFAULT_PROVIDER=fake
AGENT_MILLOW_ENABLED_PROVIDERS=fake
AGENT_MILLOW_PROVIDER_TIMEOUT=30
AGENT_MILLOW_PROVIDER_CONNECT_TIMEOUT=10
AGENT_MILLOW_PROVIDER_STREAM_TIMEOUT=120
AGENT_MILLOW_PROVIDER_RETRIES=2
AGENT_MILLOW_OPENAI_BASE_URL=https://api.openai.com/v1
AGENT_MILLOW_OPENAI_KEY=
AGENT_MILLOW_OPENAI_MODEL=gpt-4o-mini
AGENT_MILLOW_OPENAI_ALLOWED_MODELS=gpt-4o-mini
AGENT_MILLOW_OPENAI_MAX_OUTPUT_TOKENS=1024
# Leave blank unless you have verified current per-million token prices.
# Blank prices keep provider_usage.estimated_cost null.
AGENT_MILLOW_OPENAI_INPUT_COST_PER_MILLION=
AGENT_MILLOW_OPENAI_OUTPUT_COST_PER_MILLION=

# Conversations
AGENT_MILLOW_MAX_CONTEXT_MESSAGES=50
AGENT_MILLOW_MAX_MESSAGE_LENGTH=32000

# Hardening. Request size is enforced on api/* by Content-Length.
AGENT_MILLOW_REQUEST_MAX_BYTES=1048576
AGENT_MILLOW_SENSITIVE_RATE_LIMIT=10
AGENT_MILLOW_TOOL_RATE_LIMIT=30
AGENT_MILLOW_TOOL_CALLS_PER_HOUR=60
AGENT_MILLOW_TOOL_MAX_PENDING_APPROVALS=20

# HSTS is opt-in and only sent for secure requests.
AGENT_MILLOW_HSTS_ENABLED=false
AGENT_MILLOW_HSTS_MAX_AGE=31536000

# Comma-separated proxy IPs/CIDRs. Leave empty to trust no proxy.
AGENT_MILLOW_TRUSTED_PROXIES=

# Retention. maintenance:prune is a dry run unless --force is supplied, and the
# scheduler only runs it in production. Messages are retained indefinitely.
AGENT_MILLOW_AUDIT_RETENTION_DAYS=365
AGENT_MILLOW_FAILED_JOBS_RETENTION_DAYS=30
AGENT_MILLOW_PRUNE_EXPIRED_TOKENS=true
