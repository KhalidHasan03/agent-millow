# Agent Millow production environment template.
# Copy to the shared production path (for example
# /var/www/agent-millow/shared/backend/.env), replace every placeholder, keep
# the resulting file outside version control with mode 0640, and link it to
# backend/.env in each release.
#
# Do not commit a filled-in copy. Do not put secrets in Supervisor, Nginx, or
# systemd unit files; this file (or an injected secret-manager equivalent) is
# the single application configuration surface.

APP_NAME="Agent Millow"
APP_ENV=production
APP_KEY=
APP_PREVIOUS_KEYS=
APP_DEBUG=false
APP_URL=https://app.example.com
FRONTEND_URL=https://app.example.com
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=json
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=agent_millow_prod
DB_USERNAME=agent_millow_app
DB_PASSWORD=
DB_TIMEZONE=+00:00
# Optional: path to a CA bundle when the application-to-MySQL connection uses TLS.
MYSQL_ATTR_SSL_CA=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=app.example.com
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_COOKIE=agent_millow_session
SANCTUM_STATEFUL_DOMAINS=app.example.com
SANCTUM_TOKEN_PREFIX=agent_millow_
CORS_ALLOWED_ORIGINS=https://app.example.com

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
QUEUE_FAILED_DRIVER=database-uuids
DB_QUEUE=default
DB_QUEUE_RETRY_AFTER=90

CACHE_STORE=database
CACHE_PREFIX=agent_millow_prod

MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@app.example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Account provisioning. Public registration is disabled for production.
AGENT_MILLOW_REGISTRATION_ENABLED=false
AGENT_MILLOW_PRIVATE_BETA=false
AGENT_MILLOW_ALLOWED_EMAILS=
AGENT_MILLOW_ADMIN_ROLE=admin
AGENT_MILLOW_TOKEN_EXPIRATION=10080
AGENT_MILLOW_TOKEN_LIMIT=20
AGENT_MILLOW_TOKEN_NAME=api-client

# Initial administrator seeding. Leave the password blank after the one-time
# seeding step; the seeder skips when either value is empty.
AGENT_MILLOW_SEED_ADMIN_EMAIL=
AGENT_MILLOW_SEED_ADMIN_PASSWORD=

# Rate limits and resource bounds.
AGENT_MILLOW_API_RATE_LIMIT=60
AGENT_MILLOW_LOGIN_RATE_LIMIT=5
AGENT_MILLOW_REGISTER_RATE_LIMIT=5
AGENT_MILLOW_SENSITIVE_RATE_LIMIT=10
AGENT_MILLOW_CHAT_RATE_LIMIT=30
AGENT_MILLOW_MEMORY_RATE_LIMIT=30
AGENT_MILLOW_TOOL_RATE_LIMIT=30
AGENT_MILLOW_REQUEST_MAX_BYTES=1048576
AGENT_MILLOW_TOOL_CALLS_PER_HOUR=60
AGENT_MILLOW_TOOL_MAX_PENDING_APPROVALS=20

# Transport security. Keep HSTS disabled until HTTPS is verified end to end.
# Enable it only after confirming the certificate, redirect, and cookie behavior.
AGENT_MILLOW_HSTS_ENABLED=false
AGENT_MILLOW_HSTS_MAX_AGE=31536000
# Comma-separated proxy IPs/CIDRs. Leave empty when Nginx connects directly to
# PHP-FPM. Set only to the actual load balancer or CDN ranges that overwrite
# X-Forwarded-* headers.
AGENT_MILLOW_TRUSTED_PROXIES=

AGENT_MILLOW_AUDIT_RETENTION_DAYS=365
AGENT_MILLOW_FAILED_JOBS_RETENTION_DAYS=30
AGENT_MILLOW_PRUNE_EXPIRED_TOKENS=true

# Real provider configuration. The fake provider must not be enabled in
# production unless it is an intentional, isolated demonstration environment.
AGENT_MILLOW_DEFAULT_PROVIDER=openai
AGENT_MILLOW_ENABLED_PROVIDERS=openai
AGENT_MILLOW_PROVIDER_TIMEOUT=30
AGENT_MILLOW_PROVIDER_CONNECT_TIMEOUT=10
AGENT_MILLOW_PROVIDER_STREAM_TIMEOUT=120
AGENT_MILLOW_PROVIDER_RETRIES=2
AGENT_MILLOW_OPENAI_BASE_URL=https://api.openai.com/v1
AGENT_MILLOW_OPENAI_KEY=
AGENT_MILLOW_OPENAI_MODEL=gpt-4o-mini
AGENT_MILLOW_OPENAI_ALLOWED_MODELS=gpt-4o-mini
AGENT_MILLOW_OPENAI_MAX_OUTPUT_TOKENS=1024
# Leave blank unless you have verified current per-million token prices.
# Blank prices keep provider_usage.estimated_cost null.
AGENT_MILLOW_OPENAI_INPUT_COST_PER_MILLION=
AGENT_MILLOW_OPENAI_OUTPUT_COST_PER_MILLION=

AGENT_MILLOW_MAX_CONTEXT_MESSAGES=50
AGENT_MILLOW_MAX_MESSAGE_LENGTH=32000
